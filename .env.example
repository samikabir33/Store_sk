# Copy this file to .env.local and fill in your real values.

# Get this from https://resend.com after creating a free account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for password-reset emails.
# Until you verify your own domain on Resend, you can leave this unset
# to use Resend's shared test address (onboarding@resend.dev) - this only
# works for sending to the email you signed up to Resend with.
# Once your domain is verified on Resend, set it like:
# RESEND_FROM_EMAIL="Fahmida's Fashion <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# Your live site URL (used to build the logo image link inside emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing secret used to sign login sessions - keep this the same value in production.
JWT_SECRET=fahmidas-fashion-dev-secret-change-in-production
